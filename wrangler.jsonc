// Cloudflare Workers config — Indo Data API (x402 paid API).
// Deploy: npx wrangler deploy. No secrets in this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indo-data-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Public, non-secret values.
    "FACILITATOR_URL": "https://api.circle.com/v1/facilitator/x402"
    // sellerAddress is baked into src/worker.mjs (public payout address).
  }
  // Circle Facilitator Service requires an API key for verify/settle:
  //   npx wrangler secret put CIRCLE_API_KEY
  // (sent as `Authorization: Bearer <key>` via HTTPFacilitatorClient createAuthHeaders).
}
